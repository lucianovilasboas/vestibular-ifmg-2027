# Credenciais do painel FCM (Fundação CEFET-MG) — usadas pelo worker de coleta
FCM_USERNAME=coloque-seu-usuario-aqui
FCM_PASSWORD=coloque-sua-senha-aqui

# Retry da coleta (opcionais — têm default no código)
FCM_MAX_TENTATIVAS=3
FCM_AGUARDO_RETRY=30

# Copie para .env.local com os valores reais (o worker lê via env_file)
